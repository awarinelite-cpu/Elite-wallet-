# Copy this file to .env and fill in your Supabase project details.
# Find these in Supabase Dashboard → Project Settings → API

PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only in src/lib/server (never exposed to the browser).
# Needed for the seed script and any future admin-only operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack — funding (Add Money) and bank withdrawals.
# Get these from the Paystack dashboard → Settings → API Keys & Webhooks.
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# ClubKonnect — real MTN/Airtel/Glo/9mobile airtime top-ups.
# Register at clubkonnect.com, fund your wallet, then go to
# Developer's API (in the site menu) to get your UserID and generate an
# APIKey. No separate sandbox account or approval wait — it works as soon
# as your wallet has a balance.
CLUBKONNECT_USERID=your-clubkonnect-userid
CLUBKONNECT_APIKEY=your-clubkonnect-apikey
CLUBKONNECT_BASE_URL=https://www.nellobytesystems.com
