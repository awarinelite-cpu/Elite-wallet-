# Copy this file to .env and fill in your Supabase project details.
# Find these in Supabase Dashboard → Project Settings → API

PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only in src/lib/server (never exposed to the browser).
# Needed for the seed script and any future admin-only operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack — funding (Add Money) and bank withdrawals.
# Get these from the Paystack dashboard → Settings → API Keys & Webhooks.
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# VTpass — real MTN/Airtel/Glo/9mobile airtime top-ups.
# Sign up separately at sandbox.vtpass.com for test keys (a different
# account from the main vtpass.com site) — profile page → API Keys tab.
# Use VTPASS_BASE_URL=https://sandbox.vtpass.com/api while testing, and
# https://vtpass.com/api once you've requested live provisioning from
# VTpass support after sandbox testing is complete.
VTPASS_API_KEY=your-vtpass-api-key
VTPASS_SECRET_KEY=your-vtpass-secret-key
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
